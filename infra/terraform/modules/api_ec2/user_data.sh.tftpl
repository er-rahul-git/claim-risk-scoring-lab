#!/bin/bash
# Runs once at instance boot. The instance is disposable: everything comes from the image.
set -euo pipefail
REGION="${region}"

dnf install -y docker
systemctl enable --now docker

TAG=$(aws ssm get-parameter --region "$REGION" --name "${image_tag_parameter}" --query Parameter.Value --output text)
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${registry}"

docker run -d --name crs-api --restart always -p 8080:8080 \
  -e APP_ENV="${env}" \
  -e APP__storage__bucket="${bucket}" \
  -e AWS_DEFAULT_REGION="$REGION" \
  -e GIT_SHA="$TAG" \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  --log-opt awslogs-stream="$(hostname)" \
  "${repository_url}:$TAG"
