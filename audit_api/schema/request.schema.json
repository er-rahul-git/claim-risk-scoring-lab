{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit request",
  "type": "object",
  "required": ["request_id", "claim"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{3,64}$" },
    "submitted_by": { "type": "string" },
    "claim": {
      "type": "object",
      "required": ["claim_id", "provider_npi", "payer_id", "procedure_codes", "billed_amount", "service_date"],
      "additionalProperties": false,
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "provider_npi": { "type": "string", "pattern": "^[0-9]{10}$" },
        "payer_id": { "type": "string", "minLength": 2 },
        "procedure_codes": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{4,7}$" }
        },
        "billed_amount": { "type": "number", "exclusiveMinimum": 0 },
        "service_date": { "type": "string", "format": "date" }
      }
    }
  }
}
